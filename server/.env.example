# Server Environment Configuration Template
# Copy this file to .env and configure your values

PORT=5000
NODE_ENV=development

# Database Configuration
# Set USE_MEMORY_DB=true for ephemeral zero-config development (MongoMemoryServer)
# Set USE_MEMORY_DB=false and provide MONGODB_URI for persistent production database
USE_MEMORY_DB=false
MONGODB_URI=mongodb://localhost:27017/imovies

# Authentication Secrets (Replace with secure, randomly generated 256-bit keys in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRE=30d

# Frontend Client URL (For CORS configuration)
CLIENT_URL=http://localhost:5173

# Payment Gateway Configuration
# Set MOCK_PAYMENT_ENABLED=true to test checkout without a real Razorpay account
# Set MOCK_PAYMENT_ENABLED=false and provide real Razorpay credentials for live transactions
MOCK_PAYMENT_ENABLED=true
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
